{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Grupo de Oración RCC (rojo)",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "primario", "name": "Primario (cabecera, títulos)", "color": "#CF040D" },
				{ "slug": "primario-oscuro", "name": "Primario oscuro (pie)", "color": "#A3020B" },
				{ "slug": "boton", "name": "Fondo de botón", "color": "#CF040D" },
				{ "slug": "boton-texto", "name": "Texto de botón", "color": "#FFFFFF" },
				{ "slug": "acento-texto", "name": "Acento para texto", "color": "#A3020B" },
				{ "slug": "linea", "name": "Líneas y filetes", "color": "#2078C0" },
				{ "slug": "fondo", "name": "Fondo de página", "color": "#FBF7F0" },
				{ "slug": "tarjeta", "name": "Fondo de tarjeta", "color": "#FFFDF9" },
				{ "slug": "texto", "name": "Texto", "color": "#2A1F1D" },
				{ "slug": "texto-suave", "name": "Texto suave", "color": "#5C4F4B" },
				{ "slug": "borde", "name": "Borde", "color": "#E9DED0" },
				{ "slug": "blanco", "name": "Blanco", "color": "#FFFFFF" }
			]
		}
	},
	"styles": {
		"elements": {
			"heading": { "color": { "text": "var(--wp--preset--color--texto)" } },
			"link": { "color": { "text": "#1B4F7A" } },
			"button": {
				":hover": { "color": { "background": "var(--wp--preset--color--primario-oscuro)", "text": "var(--wp--preset--color--blanco)" } }
			}
		}
	}
}
